# AgentSUMO environment configuration
# Copy this file to `.env` and fill in your own credentials:
#   cp .env.example .env

# === Required ===

# Choose the AI provider: "groq" (recommended) or "anthropic".
LLM_PROVIDER=groq

# Groq key (free developer account): https://console.groq.com/keys
GROQ_API_KEY=
# Choose a Groq model that supports tool calling. This is the default.
LLM_MODEL=openai/gpt-oss-20b

# Run the Scenario, Traffic, Policy, and Impact specialists before the
# tool-using coordinator. Set false to use the coordinator only.
MULTI_AGENT_MODE=true

# Only needed when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Mapbox access token (used by the web interface for basemap rendering).
# Get one at: https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=

# Absolute path to your local SUMO installation.
# On macOS (official SUMO installer):
#   /Library/Frameworks/EclipseSUMO.framework/Versions/<version>/EclipseSUMO
# On Linux (apt install sumo):
#   /usr/share/sumo
SUMO_HOME=

# === Optional ===

# Override the base directory for AgentSUMO MCP server outputs (networks,
# trips, simulations, etc.). Defaults to the current working directory.
# AGENTSUMO_MCP_OUTPUT_BASE=
